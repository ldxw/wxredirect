# docker compose 用的变量（复制成 .env 后修改）
#   cp .env.docker.example .env
# 生成随机密码：openssl rand -hex 16

# 对外访问端口
APP_PORT=8080

# 数据库
# DB_HOST 是 compose 里数据库服务的名字，改名了这里跟着改
DB_HOST=db
DB_NAME=wxredirect
DB_USER=wxredirect
DB_PASSWORD=change-me-please
DB_ROOT_PASSWORD=change-me-too

# 说明：面板安装页里数据库地址填 db，端口 3306，
# 库名/用户名/密码填上面的 DB_NAME / DB_USER / DB_PASSWORD。
